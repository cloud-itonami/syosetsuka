{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; shousetsu craft lib (ADR-2607023000) — the serialized-fiction
        ;; vocabulary split out of this repo's old syosetsuka.edn.
        io.github.kotoba-lang/shousetsu {:git/url "https://github.com/kotoba-lang/shousetsu"
                                         :git/sha "179985f5c755218ce4a6b1e4a5e08f76f207ee05"}
        ;; kotoba-db (kotobase.net tenant Datom plane client) — §7 sovereign
        ;; gate の kotoba 実測経路 (ADR-2607022300 kotoba=storage)。
        io.github.kotoba-lang/langchain {:git/sha "c7943d7542f28242a654ff3e0c37100b48a9417d"}
        ;; host-crypto-free 純 cljc SHA-256 — cacao の canonical-graph CID /
        ;; did:key を JVM/cljs/SCI/WASM どこでも同一に計算する (ADR-2607012300)。
        io.github.com-junkawasaki/sha256d-clj {:git/sha "5fd4e64d0fc5a616b798edbca7327da33c78eb02"}
        http-kit/http-kit   {:mvn/version "2.8.0"}
        metosin/reitit-ring {:mvn/version "0.7.2"}
        ring/ring-core      {:mvn/version "1.12.2"}
        metosin/jsonista    {:mvn/version "0.3.11"}}
 :aliases
 {;; Workspace development — use the local lib checkout (no git fetch).
  :dev
  {:override-deps
   {io.github.kotoba-lang/shousetsu {:local/root "../../../kotoba-lang/shousetsu"}
    io.github.kotoba-lang/langchain  {:local/root "../../../kotoba-lang/langchain"}
    io.github.com-junkawasaki/sha256d-clj {:local/root "../../../com-junkawasaki/sha256d-clj"}}}

  :run {:main-opts ["-m" "syosetsuka.server"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
