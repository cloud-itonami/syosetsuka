{:paths ["src" "resources"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.text"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        ;; shousetsu craft lib (ADR-2607023000) — the serialized-fiction
        ;; vocabulary split out of this repo's old syosetsuka.edn.
        io.github.kotoba-lang/shousetsu
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.shousetsu"}
        ;; kotoba-db (kotobase.net tenant Datom plane client) — §7 sovereign
        ;; gate の kotoba 実測経路 (ADR-2607022300 kotoba=storage)。
        io.github.kotoba-lang/langchain
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.langchain"}
        ;; host-crypto-free 純 cljc SHA-256 — cacao の canonical-graph CID /
        ;; did:key を JVM/cljs/SCI/WASM どこでも同一に計算する (ADR-2607012300)。
        io.github.kotoba-lang/sha256d
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "7e1dbe0aece831138e6106c59d2b26375d0f60c4"
         :deps/root "lib/kotoba.sha256d"}
        http-kit/http-kit   {:mvn/version "2.8.0"}
        metosin/reitit-ring {:mvn/version "0.7.2"}
        ring/ring-core      {:mvn/version "1.12.2"}
        metosin/jsonista    {:mvn/version "0.3.11"}}
 :aliases
 {;; Workspace development — use the local lib checkout (no git fetch).
  :dev
  {:override-deps
   {io.github.kotoba-lang/shousetsu
        {:local/root "../../../kotoba-lang/kotoba/lib/kotoba.shousetsu"}
    io.github.kotoba-lang/langchain
        {:local/root "../../../kotoba-lang/kotoba/lib/kotoba.langchain"}
    io.github.kotoba-lang/sha256d
        {:local/root "../../../kotoba-lang/kotoba/lib/kotoba.sha256d"}}}

  :run {:main-opts ["-m" "syosetsuka.server"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}}}
